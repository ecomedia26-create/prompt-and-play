{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "includeFiles": "src/data/public_skills_data.json",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "prompt-and-play-sepia.vercel.app"
        }
      ],
      "destination": "https://www.promptandplay.co.il/:path*",
      "permanent": true
    }
  ]
}
