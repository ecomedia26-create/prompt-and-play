{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "includeFiles": "src/data/public_skills_data.json",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "prompt-and-play-sepia.vercel.app"
        }
      ],
      "destination": "https://www.promptandplay.co.il/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "calc.ecomedia.co.il"
        }
      ],
      "destination": "https://www.ecomedia.co.il/calculator",
      "permanent": false
    },
    {
      "source": "/calculator",
      "destination": "https://www.ecomedia.co.il/calculator",
      "permanent": true
    },
    {
      "source": "/calculator.html",
      "destination": "https://www.ecomedia.co.il/calculator",
      "permanent": true
    },
    {
      "source": "/calculator/:path*",
      "destination": "https://www.ecomedia.co.il/calculator",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "offer.ecomedia.co.il"
        }
      ],
      "destination": "/offer",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/offer",
      "destination": "/offer/index.html"
    }
  ],
  "headers": [
    {
      "source": "/offer(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "offer.ecomedia.co.il"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
